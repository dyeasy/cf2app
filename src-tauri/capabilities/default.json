{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "dialog:default",
    {
      "identifier": "store:allow-get-store",
      "allow": [{ "path": "appconfig.json" }]
    },
    {
      "identifier": "store:allow-set",
      "allow": [{ "path": "appconfig.json" }]
    },
    {
      "identifier": "store:allow-save",
      "allow": [{ "path": "appconfig.json" }]
    }
  ]
}
